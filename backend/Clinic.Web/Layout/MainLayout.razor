@inherits LayoutComponentBase
@inject JwtAuthStateProvider Auth
@inject NavigationManager Navigation

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <AuthorizeView>
            <Authorized>
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
            </Authorized>
        </AuthorizeView>
        <MudText Typo="Typo.h6" Class="ml-2">Phòng khám Clinic</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2" Class="mr-3">
                    @context.User.FindFirst("name")?.Value (@UiFormat.RoleLabel(context.User.FindFirst("role")?.Value))
                </MudText>
                <MudButton Color="Color.Inherit" OnClick="LogoutAsync">Đăng xuất</MudButton>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="doctors" Color="Color.Inherit">Bác sĩ</MudButton>
                <MudButton Href="login" Color="Color.Inherit">Đăng nhập</MudButton>
                <MudButton Href="register" Color="Color.Inherit">Đăng ký</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <AuthorizeView>
        <Authorized>
            <MudDrawer @bind-Open="_drawerOpen" Elevation="1" ClipMode="DrawerClipMode.Always">
                <NavMenu />
            </MudDrawer>
        </Authorized>
    </AuthorizeView>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#0F766E",
            AppbarBackground = "#0F766E"
        }
    };

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task LogoutAsync()
    {
        await Auth.SignOutAsync();
        Navigation.NavigateTo("login");
    }
}