@inherits LayoutComponentBase
@inject JwtAuthStateProvider Auth
@inject NavigationManager Navigation

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="clinic-appbar">
        <AuthorizeView>
            <Authorized>
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
            </Authorized>
        </AuthorizeView>

        <a href="" class="brand">
            <ClinicLogo />
            <span class="brand-text d-none d-sm-inline">Phòng khám Clinic</span>
        </a>

        <MudSpacer />

        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2" Class="mr-3 d-none d-sm-flex">
                    @context.User.FindFirst("name")?.Value (@UiFormat.RoleLabel(context.User.FindFirst("role")?.Value))
                </MudText>
                <MudButton Color="Color.Inherit" OnClick="LogoutAsync">Đăng xuất</MudButton>
            </Authorized>
            <NotAuthorized>
                <nav class="topnav d-none d-md-flex">
                    <NavLink class="topnav-link" href="" Match="NavLinkMatch.All">Trang chủ</NavLink>
                    <NavLink class="topnav-link" href="book">Đặt lịch</NavLink>
                    <NavLink class="topnav-link" href="doctors">Xem bác sĩ</NavLink>
                </nav>
                <a class="btn-top btn-top-filled" href="login">Đăng nhập</a>
                <a class="btn-top btn-top-outline" href="register">Đăng ký</a>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <AuthorizeView>
        <Authorized>
            <MudDrawer @bind-Open="_drawerOpen" Elevation="1" ClipMode="DrawerClipMode.Always">
                <NavMenu />
            </MudDrawer>
        </Authorized>
    </AuthorizeView>

    <MudMainContent>
        <AuthorizeView>
            <Authorized>
                <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-6">
                    @Body
                </MudContainer>
            </Authorized>
            <NotAuthorized>
                @if (IsHome)
                {
                    @* Trang chủ cho khách: tràn hết chiều ngang để phần giới thiệu có nền riêng *@
                    @Body
                }
                else
                {
                    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-6">
                        @Body
                    </MudContainer>
                }
            </NotAuthorized>
        </AuthorizeView>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#0F766E",
            AppbarBackground = "#0F766E"
        }
    };

    private bool IsHome => new Uri(Navigation.Uri).AbsolutePath == "/";

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task LogoutAsync()
    {
        await Auth.SignOutAsync();
        Navigation.NavigateTo("login");
    }
}