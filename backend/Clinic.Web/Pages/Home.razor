@page "/"

<PageTitle>Trang chủ</PageTitle>

<AuthorizeView>
    <Authorized>
        <MudText Typo="Typo.h4" Class="mb-2">Xin chào, @context.User.FindFirst("name")?.Value</MudText>
        <MudText Class="mb-4">Vai trò của bạn: <b>@UiFormat.RoleLabel(context.User.FindFirst("role")?.Value)</b></MudText>

        <AuthorizeView Roles="@RoleNames.Patient" Context="p">
            <MudButton Href="book" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Class="mr-2 mb-2">Đặt lịch khám</MudButton>
            <MudButton Href="my-appointments" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" Class="mr-2 mb-2">Lịch hẹn của tôi</MudButton>
            <MudButton Href="my-history" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" Class="mr-2 mb-2">Lịch sử khám</MudButton>
        </AuthorizeView>

        <AuthorizeView Roles="@RoleNames.Receptionist" Context="r">
            <MudButton Href="reception/appointments" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Class="mr-2 mb-2">Lịch hẹn hôm nay</MudButton>
            <MudButton Href="reception/new-booking" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" Class="mr-2 mb-2">Đặt lịch hộ</MudButton>
            <MudButton Href="reception/billing" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" Class="mr-2 mb-2">Thanh toán</MudButton>
        </AuthorizeView>

        <AuthorizeView Roles="@RoleNames.Doctor" Context="d">
            <MudButton Href="doctor/appointments" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Class="mr-2 mb-2">Lịch khám hôm nay</MudButton>
        </AuthorizeView>

        <AuthorizeView Roles="@RoleNames.Admin" Context="a">
            <MudButton Href="admin/dashboard" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Class="mr-2 mb-2">Dashboard</MudButton>
            <MudButton Href="admin/doctors" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" Class="mr-2 mb-2">Quản lý bác sĩ</MudButton>
        </AuthorizeView>
    </Authorized>
    <NotAuthorized>
        <MudPaper Class="pa-8 text-center" Elevation="0">
            <MudText Typo="Typo.h3" Class="mb-2">Phòng khám Clinic</MudText>
            <MudText Typo="Typo.h6" Class="mb-6">Đặt lịch khám nhanh chóng, theo dõi hồ sơ và hóa đơn mọi lúc.</MudText>
            <MudButton Href="login" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Class="mr-2">Đăng nhập</MudButton>
            <MudButton Href="register" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" Class="mr-2">Đăng ký</MudButton>
            <MudButton Href="doctors" Variant="Variant.Text" Color="Color.Primary" Size="Size.Large">Xem bác sĩ</MudButton>
        </MudPaper>
    </NotAuthorized>
</AuthorizeView>


